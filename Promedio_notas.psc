Algoritmo Promedio_notas
	definir nota1 Como real
	Escribir "¿Que nota sacaste en el primer examen?"
	Leer nota1
	definir nota2 Como real
	Escribir "Que nota sacaste en el segundo examen?"
	Leer nota2
	definir nota3 Como real
	Escribir "Que nota sacaste en el tercer examen?"
	Leer nota3
	promedio_de_notas = (nota1+nota2+nota3)/3
	Escribir "Tu promedio es = " (promedio_de_notas)
FinAlgoritmo
